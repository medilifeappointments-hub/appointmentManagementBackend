{
  "name": "clinic-appointments-server",
  "version": "1.0.0",
  "private": true,
  "description": "Internal clinic appointment data-entry API",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"prisma/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"prisma/**/*.ts\" \"*.ts\"",
    "start": "node server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "seed:admin": "tsx prisma/seed-admin.ts",
    "postinstall": "prisma generate",
    "db:local": "tsx scripts/local-db.ts",
    "admin:reset-password": "tsx scripts/reset-admin-password.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.5",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "luxon": "3.7.2",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/supertest": "7.2.1",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "^3.6.2",
    "supertest": "7.3.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
