# ==========================================================
# BACKEND PRODUCTION ENVIRONMENT
# Copy these values into your backend hosting environment.
# Replace every value containing CHANGE_ME.
# Do not commit the completed file or real secrets to GitHub.
# ==========================================================

# REQUIRED: Enables secure cookies and production error handling.
NODE_ENV=production

# REQUIRED: Most hosting providers supply PORT automatically.
# Keep this fallback only when your provider does not supply it.
PORT=4000

# REQUIRED: Neon POOLED connection URL used by the running backend.
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_POOLER_HOST/CHANGE_ME_DATABASE?sslmode=verify-full

# REQUIRED DURING DEPLOYMENT: Neon DIRECT connection URL used by Prisma migrations.
DIRECT_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_DIRECT_HOST/CHANGE_ME_DATABASE?sslmode=require

# REQUIRED: Clinic timezone used for appointments and monthly reports.
CLINIC_TIMEZONE=Asia/Dubai

# REQUIRED: Exact live frontend URL. Do not add a trailing slash.
# Example: https://clinic-appointments.vercel.app
CORS_ORIGINS=https://CHANGE_ME_FRONTEND_URL

# REQUIRED SECRET: Use at least 32 random characters.
# Generate once with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CSRF_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# REQUIRED ON MOST HOSTS: Use 1 when one trusted proxy sits in front of Node.
# Use 0 only when Express is directly exposed without a reverse proxy.
TRUST_PROXY=1

# OPTIONAL: Safe production defaults. Keep these unless you need different limits.
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
LOGIN_RATE_LIMIT_MAX=10
SENSITIVE_RATE_LIMIT_MAX=30

# FIRST DEPLOYMENT ONLY: Set these temporarily, run `npm run seed:admin`,
# then delete all three variables from the hosting environment.
# SEED_ADMIN_NAME=CHANGE_ME
# SEED_ADMIN_EMAIL=CHANGE_ME
# SEED_ADMIN_PASSWORD=CHANGE_ME

# DO NOT SET IN PRODUCTION:
# LOCAL_DB_PORT is only for the optional local PostgreSQL server.
# LOCAL_DB_PASSWORD is only for the optional local PostgreSQL server.
# ADMIN_NEW_PASSWORD should exist only temporarily during an emergency password reset.
