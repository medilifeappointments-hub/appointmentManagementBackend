# Required backend deployment environment
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@POOLED_NEON_HOST/clinic_prod?sslmode=verify-full
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_NEON_HOST/clinic_prod?sslmode=require
CLINIC_TIMEZONE=Asia/Dubai
CORS_ORIGINS=https://appointments.example.com
CSRF_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY=1

# Optional security/session tuning
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
LOGIN_RATE_LIMIT_MAX=10
SENSITIVE_RATE_LIMIT_MAX=30

# Set temporarily only when creating the first administrator, then remove them.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
