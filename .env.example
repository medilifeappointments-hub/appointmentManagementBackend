# Server mode. Use development locally, test in automated tests, and production when deployed.
NODE_ENV=development

# Port on which the Express API listens. The frontend development proxy expects 4000 by default.
PORT=4000

# Runtime PostgreSQL connection. Use the Neon pooled URL; its hostname normally contains "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.REGION.aws.neon.tech/clinic_dev?sslmode=verify-full"

# Migration PostgreSQL connection. Use the Neon direct URL; Prisma uses it for migration commands only.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example-123456.REGION.aws.neon.tech/clinic_dev?sslmode=require"

# Clinic timezone used to save, display, filter, and report appointment dates and times.
CLINIC_TIMEZONE=Asia/Dubai

# Frontend origins allowed to call the API and make authenticated changes. Separate multiple URLs with commas.
CORS_ORIGINS=http://localhost:5173

# Secret used to sign CSRF protection tokens. It must contain at least 32 random characters.
# Generate it with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CSRF_SECRET=replace-with-a-long-random-value

# Maximum number of hours a login session can exist, even while the user remains active.
SESSION_TTL_HOURS=12

# Number of inactive minutes after which a login session expires.
SESSION_IDLE_MINUTES=120

# Number of trusted reverse proxies in front of Express. Use 0 locally and usually 1 when deployed.
TRUST_PROXY=0

# Maximum login attempts allowed per IP during each 15-minute rate-limit window.
LOGIN_RATE_LIMIT_MAX=10

# Maximum sensitive account operations allowed per IP during each 15-minute window.
SENSITIVE_RATE_LIMIT_MAX=30

# Full name used only by `npm run seed:admin` when creating the first super administrator.
SEED_ADMIN_NAME=

# Login email used only when creating the first super administrator.
SEED_ADMIN_EMAIL=

# Initial password used only when creating the first super administrator. Remove it after seeding.
SEED_ADMIN_PASSWORD=

# Port used by the optional local embedded PostgreSQL server started with `npm run db:local`.
LOCAL_DB_PORT=5433

# Password for the optional local embedded PostgreSQL server. Never use it for Neon or production.
LOCAL_DB_PASSWORD=

# Temporary emergency password used by `npm run admin:reset-password -- <email>`. Remove it after use.
ADMIN_NEW_PASSWORD=
