# ---------------------------------------------------------------------------
# Server environment. Copy to .env and fill in. NEVER commit real values.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Neon POOLED connection string (hostname contains "-pooler"). Used at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.REGION.aws.neon.tech/clinic_dev?sslmode=verify-full"
# Neon DIRECT connection string (no "-pooler"). Used only by the Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example-123456.REGION.aws.neon.tech/clinic_dev?sslmode=require"

# IANA timezone the clinic operates in. All entry, display and day filters use it.
CLINIC_TIMEZONE=Asia/Dubai

# Comma-separated browser origins allowed to call the API (development CORS + Origin check).
# In production with same-origin /api proxying, set this to the public app origin.
CORS_ORIGINS=http://localhost:5173

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CSRF_SECRET=replace-with-a-long-random-value

# Session lifetime: absolute maximum and idle timeout.
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# Number of reverse-proxy hops in front of Express (0 locally, usually 1 in production).
TRUST_PROXY=0

# Rate limits (per IP, 15 minute window).
LOGIN_RATE_LIMIT_MAX=10
SENSITIVE_RATE_LIMIT_MAX=30

# Used ONLY by `npm run seed:admin` to create the first super admin. Remove after seeding.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional: `npm run db:local` runs a development-only PostgreSQL (no Neon/Docker needed).
LOCAL_DB_PORT=5433
LOCAL_DB_PASSWORD=

# Optional: password applied by `npm run admin:reset-password -- <email>`. Remove after use.
ADMIN_NEW_PASSWORD=
